MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=votre_utilisateur_mysql
MYSQL_PASSWORD=votre_mot_de_passe
MYSQL_DATABASE=gica

# Secret JWT (optionnel) : s'il est absent, un secret persistant est généré dans db/.jwt_secret
# JWT_SECRET=

# Configuration SMTP pour notifications email.
# Obligatoire : sans ces trois variables, l'envoi d'emails est désactivé (aucun compte par défaut).
SMTP_HOST=mail.exemple.com
SMTP_PORT=587
SMTP_USER=votre_email@exemple.com
SMTP_PASS=votre_mot_de_passe_email
SMTP_SECURE=false
# Mettre true uniquement pour un serveur SMTP interne à certificat auto-signé.
SMTP_TLS_INSECURE=false
SMTP_FROM="Portail RH GICA" <votre_email@exemple.com>

# URL publique du backend, utilisée dans les liens de validation envoyés par email
# (ex: http://192.168.1.20:8081 ou https://rh.schb-gica.dz)
SERVER_URL=http://localhost:8081

# Mettre false sur une installation réelle : empêche la création des comptes de démonstration
# (1001/1001, 1002/1002, ...) lors de l'initialisation d'une base vide.
SEED_DEMO=true
